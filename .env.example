# Copy to `.env` and fill in, then run:
#   flutter run --dart-define-from-file=.env
#
# All values are optional — the app ships with working defaults that talk to the
# public MobileAI cloud. Override only what you need.

# Base URL for the MobileAI hosted text/voice proxy + telemetry.
# Default: https://mobileai.cloud
# For local backend development use e.g. http://localhost:3001
EXPO_PUBLIC_MOBILEAI_BASE_URL=https://mobileai.cloud

# MobileAI publishable key (sent as `Authorization: Bearer <key>`).
# This is a *publishable* key (mobileai_pub_...), not a secret.
EXPO_PUBLIC_MOBILEAI_KEY=mobileai_pub_37aef8662883f2eba40dfc70763f4ef5b1a1a686

# Direct Gemini API key — only used as a fallback when no proxy URL is set.
# Leave empty to rely on the hosted proxy above.
GEMINI_API_KEY=
